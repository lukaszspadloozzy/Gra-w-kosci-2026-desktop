<Window x:Class="Gra_w_kości_2026_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gra w kości 2026" Height="450" Width="400"
        Background="#ED27C121">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Image x:Name="obraz0" Width="60" Height="60" Margin="10" Tag="0" MouseLeftButtonDown="Kosc_Click"/>
            <Image x:Name="obraz1" Width="60" Height="60" Margin="10" Tag="1" MouseLeftButtonDown="Kosc_Click"/>
            <Image x:Name="obraz2" Width="60" Height="60" Margin="10" Tag="2" MouseLeftButtonDown="Kosc_Click"/>
            <Image x:Name="obraz3" Width="60" Height="60" Margin="10" Tag="3" MouseLeftButtonDown="Kosc_Click"/>
            <Image x:Name="obraz4" Width="60" Height="60" Margin="10" Tag="4" MouseLeftButtonDown="Kosc_Click"/>
        </StackPanel>

        <Button Content="RZUT" Margin="10" Width="100"
                Background="#ED275021" Foreground="White"
                Click="Rzut_Click"/>

        <TextBox x:Name="wynik" Text="0" FontSize="40" Margin="10"
                 Width="120" TextAlignment="Center" IsReadOnly="True"/>

    </StackPanel>
</Window>